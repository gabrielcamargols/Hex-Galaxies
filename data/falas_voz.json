 },
 "kling": {
  "Oi, oi! Trouxe minhas ferramentas e umas invenções novas!": "v_kling_l01",
  "Uau! Quanta coisa pra consertar aqui!": "v_kling_l02",
  "Meu irmão é o melhor atirador do mar... e eu sou o melhor consertador!": "v_kling_l03",
  "Hum... o que será que acontece se eu apertar esse botão? Não, não... depois eu vejo.": "v_kling_l04",
  "Ei, não mexe com a gente! Senão... senão eu conto pro meu irmão!": "v_kling_l05",
  "Sabia que sua armadura tem um defeito bem ali?": "v_kling_l06",
  "Eu vi! Fica pertinho, tá?": "v_kling_l07",
  "Eu conserto você rapidinho, pode deixar comigo!": "v_kling_l08",
