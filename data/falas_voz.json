  "Olha nos meus olhos... e não se mexe.": "v_a_medusa_l19",
  "Eu avisei pra não encostar.": "v_a_medusa_l20"
 },
 "a_lumina": {
  "Sigam a luzinha... isso, mais perto.": "v_a_lumina_l01",
  "No escuro do abismo, eu sou o farol. E a armadilha.": "v_a_lumina_l02",
  "Que escuro aqui... ainda bem que eu trouxe luz pra todo mundo.": "v_a_lumina_l03",
  "Hihi... peixinhos novos no aquário.": "v_a_lumina_l04",
  "Olha pra luz. Só um pouquinho.": "v_a_lumina_l05",
  "Que sorriso lindo o seu. O meu é maior.": "v_a_lumina_l06",
  "Eu ofusco, você morde. Combinado?": "v_a_lumina_l07",
  "Deixa comigo, eu ilumino o caminho.": "v_a_lumina_l08",
  "Vai lá! Eu cubro daqui de longe.": "v_a_lumina_l09",
